{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant restaurant account and configuration record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique tenant ID (e.g. rest_lakeview_01)" },
        "slug": { "type": "string", "description": "Subdomain slug (e.g. lakeview)" },
        "name": { "type": "string", "description": "Official restaurant name" },
        "tagline": { "type": "string", "description": "Restaurant slogan / description" },
        "location": { "type": "string", "description": "Physical address" },
        "currency": { "type": "string", "description": "Currency code (MWK)" },
        "currencySymbol": { "type": "string", "description": "Currency display symbol (MK)" },
        "serviceChargeRate": { "type": "number", "description": "Service charge percentage (e.g. 0.10)" },
        "idleAlertMinutes": { "type": "number", "description": "Inactivity threshold in minutes" }
      },
      "required": ["id", "slug", "name"]
    },
    "TableSession": {
      "title": "TableSession",
      "description": "Active dining tab and live order session for a restaurant table",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique session ID" },
        "tableId": { "type": "string", "description": "ID of the assigned physical table" },
        "tableName": { "type": "string", "description": "Display name of table (e.g. Table 12)" },
        "status": {
          "type": "string",
          "enum": ["available", "occupied", "waiting_payment", "unattended"],
          "description": "Operational table status"
        },
        "currentGuest": { "type": "string", "description": "Active user identity on the device" },
        "guests": {
          "type": "array",
          "description": "List of active guests who ordered at this table"
        },
        "items": {
          "type": "array",
          "description": "List of ordered food and drink items on this table"
        },
        "subtotal": { "type": "number", "description": "Subtotal in MWK" },
        "serviceCharge": { "type": "number", "description": "Service charge in MWK" },
        "totalAmount": { "type": "number", "description": "Total outstanding amount in MWK" },
        "paidAmount": { "type": "number", "description": "Total amount paid so far in MWK" },
        "paidBy": { "type": "string", "description": "Name of guest who made payment" },
        "paymentState": {
          "type": "string",
          "enum": ["UNPAID", "PAYMENT_REQUESTED", "PROCESSING", "WAITING_FOR_CONFIRMATION", "PAYMENT_CONFIRMED", "READY_TO_CLOSE", "SESSION_CLOSED", "FAILED"],
          "description": "State machine of table billing"
        },
        "paymentMethod": { "type": "string", "description": "Selected method: mobile_money, cash, card" },
        "mobileMoneyProvider": { "type": "string", "description": "airtel or mpamba" },
        "phoneNumber": { "type": "string", "description": "USSD prompt phone number" },
        "assistanceRequests": {
          "type": "array",
          "description": "Active staff assistance calls for the table"
        },
        "paymentHistory": {
          "type": "array",
          "description": "Historical payment receipts for this session"
        },
        "isPaid": { "type": "boolean", "description": "Whether current items are fully settled" },
        "createdAt": { "type": "number", "description": "Unix timestamp session opened" },
        "lastActiveTime": { "type": "number", "description": "Unix timestamp of last action" }
      },
      "required": ["sessionId", "tableId", "tableName", "status"]
    },
    "RestaurantTable": {
      "title": "RestaurantTable",
      "description": "Physical restaurant floor table record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Table unique ID" },
        "name": { "type": "string", "description": "Table display name" },
        "number": { "type": "number", "description": "Table number" },
        "capacity": { "type": "number", "description": "Seating capacity" },
        "section": { "type": "string", "description": "Dining area section" },
        "assignedWaiter": { "type": "string", "description": "Assigned staff member" }
      },
      "required": ["id", "name", "number", "capacity", "section"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Tenant restaurant registry"
    },
    "/tenants/{tenantId}/table_sessions/{tableId}": {
      "schema": "TableSession",
      "description": "Tenant-scoped live table sessions and order tabs"
    },
    "/tenants/{tenantId}/restaurant_tables/{tableId}": {
      "schema": "RestaurantTable",
      "description": "Tenant-scoped table records"
    },
    "/table_sessions/{tableId}": {
      "schema": "TableSession",
      "description": "Real-time synchronizing live table session and order tabs (root fallback)"
    }
  }
}
