rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /_connection_test/{testId} {
      allow read, write: if true;
    }

    // Multi-Tenant Restaurant Registry
    match /tenants/{tenantId} {
      allow read, write: if true;

      // Scoped Table Sessions
      match /table_sessions/{tableId} {
        allow read, write: if true;
      }

      // Scoped Restaurant Tables
      match /restaurant_tables/{tableId} {
        allow read, write: if true;
      }
    }

    // Root fallback collections for backward compatibility
    match /table_sessions/{tableId} {
      allow read, write: if true;
    }

    match /restaurant_tables/{tableId} {
      allow read, write: if true;
    }
  }
}
