rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /_connection_test/{testId} {
      allow read, write: if true;
    }

    // Table Sessions: live synchronized dining table tabs & orders
    match /table_sessions/{tableId} {
      allow read, write: if true;
    }

    // Restaurant Tables: floor layout, seating and assignments
    match /restaurant_tables/{tableId} {
      allow read, write: if true;
    }
  }
}
